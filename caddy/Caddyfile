https://192.168.194.69:8443, https://localhost:8443, https://127.0.0.1:8443 {
    tls /etc/caddy/certs/192.168.194.69.pem /etc/caddy/certs/192.168.194.69-key.pem
    
    # Проксируем API на Go бэкенд
    handle /api/* {
        reverse_proxy host.docker.internal:8080
    }
}

https://192.168.194.69:9443, https://localhost:9443, https://127.0.0.1:9443 {
    tls /etc/caddy/certs/192.168.194.69.pem /etc/caddy/certs/192.168.194.69-key.pem

    # Проксируем S3 (картинки/видео) на nginx/MinIO
    reverse_proxy nginx:9090
}